# Copy this file to .env.local and fill in your own values.

# Your Supabase project (Project Settings > API). The publishable key is safe in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave empty to reach the backend (http://localhost:8000) through the Vite proxy.
VITE_API_URL=
