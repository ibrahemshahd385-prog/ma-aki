# Copy this file to .env and fill in your own values. Never upload the real .env.

# Your Supabase project URL (Project Settings > API). Used to check sign-ins.
SUPABASE_URL=https://your-project.supabase.co

# Claude API key, for Wanas and the lab report reading. Keep it secret.
ANTHROPIC_API_KEY=

# Optional
# ALLOWED_ORIGINS=http://localhost:5173
# CLAUDE_MODEL=claude-sonnet-5-5
